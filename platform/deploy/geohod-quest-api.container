# Quadlet container unit: GeoQuest Rust/Axum API.
# Install to: ~/.config/containers/systemd/geohod-quest-api.container
#
# Published ONLY on the loopback interface (127.0.0.1:8082). The public reaches
# it solely through Caddy (api.quest.geohod.ru -> localhost:8082); port 8082 is
# not externally routable. 8082 is chosen because 8080/8081 are already taken by
# the existing Caddy sites (app./dev.geohod.ru).
[Unit]
Description=GeoQuest API
# The database is managed Postgres (Supabase), reached over the internet — there
# is no local DB unit to order against. The app connects eagerly at boot with a
# bounded in-process retry (main.rs); Restart=always below absorbs any longer
# outage (e.g. a Supabase cold start) until the pooler accepts connections.

[Container]
ContainerName=geohod-quest-api
# GHCR image built by .github/workflows/backend-image.yml.
# For a build-on-VPS fallback, replace with: localhost/geohod-quest-api:latest
Image=ghcr.io/naborka/geohod-quest-api:latest
# Enables `podman auto-update`: the timer re-pulls this tag when its registry
# digest changes, restarts the unit, and rolls back to the previous image if the
# new container fails to start. This is how a release reaches the VPS — pull-based,
# so nothing inbound is needed here. The stock timer fires DAILY, which would stall
# every release: install deploy/podman-auto-update.timer.d/override.conf to
# reconcile every minute (DEPLOYMENT.md → Releases → One-time setup).
#
# Do NOT pin this to a :sha-/:build- tag except to hold a rollback: a pinned unit
# stops tracking :latest, so the release gate would time out on every deploy.
AutoUpdate=registry
PublishPort=127.0.0.1:8082:8082
Environment=PORT=8082
Environment=RUST_LOG=geohod_backend=info,tower_http=warn
# Connection-pool cap (see main.rs). Modest so we stay within Supabase's session
# pooler budget; raise for a larger plan/instance.
Environment=DB_MAX_CONNECTIONS=5
# CORS allowlist (comma-separated; exact origins or single-* wildcards). MUST be
# set in production or the API reflects ANY origin. Replace the prod frontend
# origin below with the real Vercel custom domain; the wildcard covers previews.
Environment=CORS_ALLOWED_ORIGINS=https://quest.geohod.ru,https://*.vercel.app
# Full Supabase connection string (incl. password) lives in a podman secret. Use
# the SESSION-mode pooler host with sslmode=require — NOT the IPv6-only direct
# host and NOT the :6543 transaction pooler (see DEPLOYMENT.md):
#   postgres://postgres.<ref>:<enc-pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
Secret=geohod-quest-database-url,type=env,target=DATABASE_URL
# Shared secret enabling the admin telemetry endpoints (fail-closed if unset).
Secret=geohod-quest-admin-token,type=env,target=ADMIN_TOKEN
# Media storage → Cloudflare R2 (see the R2 runbook in DEPLOYMENT.md). The
# identifiers are plain config; the two S3 API-token keys are podman secrets. All
# five must be present for production R2 — otherwise the API falls back to
# in-process media (uploads would not survive a restart).
Environment=R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
Environment=R2_BUCKET=geohod-quest-media
# Public base media URLs are built from ("{base}/{hash}"), baked into stored quest
# JSON. NO custom domain on this deploy: serve R2 through the API's own origin via
# GET /api/media/{hash} (media.rs R2 get()). MUST be byte-identical here AND in the
# import env. With a custom domain later, set both to https://media.<domain> and
# re-import (URLs are baked).
Environment=R2_PUBLIC_BASE_URL=https://api.quest.geohod.ru/api/media
Secret=geohod-quest-r2-access-key-id,type=env,target=R2_ACCESS_KEY_ID
Secret=geohod-quest-r2-secret-access-key,type=env,target=R2_SECRET_ACCESS_KEY
# Transactional mail (password reset / email confirmation). The FULL smtp url —
# including login and password — lives in a podman secret because the password
# is embedded in it. Beget: the login is the whole mailbox address, so its @
# must be URL-encoded as %40 (likewise any : / @ + in the password). Create it
# on the VPS with (paste the url, press Enter, Ctrl-D):
#   podman secret create geohod-quest-smtp-url -
#   smtps://no-reply%40geohod.ru:<url-encoded-password>@smtp.beget.com:465
# (or STARTTLS: smtp://no-reply%40geohod.ru:<enc-pw>@smtp.beget.com:587?tls=required)
# When the secret is absent, mails are logged instead of sent — remove the
# Secret= line below until the secret exists, or the unit fails to start.
Secret=geohod-quest-smtp-url,type=env,target=SMTP_URL
# Payments — YooKassa (fail-closed: without BOTH values checkout offers only the
# mock provider and provider=yookassa answers 501). The shop id is plain config
# (dashboard > Settings > Shop); the secret API key lives in a podman secret.
# Create it on the VPS with (paste the key, press Enter, Ctrl-D):
#   podman secret create geohod-quest-yookassa-secret-key -
# Then set the shop id below and uncomment both lines. Also register the webhook
# in the YooKassa dashboard (Integration > HTTP notifications):
#   https://api.quest.geohod.ru/api/payments/yookassa/webhook
# with events payment.succeeded + payment.canceled. (The API also settles lazily
# on the return-page poll, so the webhook is a resilience layer, not a hard
# dependency — but register it: it covers payers who never return to the site.)
# Environment=YOOKASSA_SHOP_ID=REPLACE_WITH_SHOP_ID
# Secret=geohod-quest-yookassa-secret-key,type=env,target=YOOKASSA_SECRET_KEY
# From header; its mailbox must be one the SMTP account is allowed to send as.
Environment=MAIL_FROM=no-reply@geohod.ru
# Public frontend origin baked into emailed reset/confirm links.
Environment=FRONTEND_BASE=https://quest.geohod.ru

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
