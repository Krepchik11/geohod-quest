# Quadlet container unit: GeoQuest Rust/Axum API.
# Install to: ~/.config/containers/systemd/geohod-quest-api.container
#
# Published ONLY on the loopback interface (127.0.0.1:8082). The public reaches
# it solely through Caddy (api.quest.geohod.ru -> localhost:8082); port 8082 is
# not externally routable. 8082 is chosen because 8080/8081 are already taken by
# the existing Caddy sites (app./dev.geohod.ru).
[Unit]
Description=GeoQuest API
# The database is managed Postgres (Supabase), reached over the internet — there
# is no local DB unit to order against. The app connects eagerly at boot with a
# bounded in-process retry (main.rs); Restart=always below absorbs any longer
# outage (e.g. a Supabase cold start) until the pooler accepts connections.

[Container]
ContainerName=geohod-quest-api
# GHCR image built by .github/workflows/backend-image.yml.
# For a build-on-VPS fallback, replace with: localhost/geohod-quest-api:latest
Image=ghcr.io/naborka/geohod-quest-api:latest
# Enables `podman auto-update`: the timer re-pulls this tag when its registry
# digest changes, restarts the unit, and rolls back to the previous image if the
# new container fails to start.
AutoUpdate=registry
PublishPort=127.0.0.1:8082:8082
Environment=PORT=8082
Environment=RUST_LOG=geohod_backend=info,tower_http=warn
# Connection-pool cap (see main.rs). Modest so we stay within Supabase's session
# pooler budget; raise for a larger plan/instance.
Environment=DB_MAX_CONNECTIONS=5
# CORS allowlist (comma-separated; exact origins or single-* wildcards). MUST be
# set in production or the API reflects ANY origin. Replace the prod frontend
# origin below with the real Vercel custom domain; the wildcard covers previews.
Environment=CORS_ALLOWED_ORIGINS=https://app.quest.geohod.ru,https://*.vercel.app
# Full Supabase connection string (incl. password) lives in a podman secret. Use
# the SESSION-mode pooler host with sslmode=require — NOT the IPv6-only direct
# host and NOT the :6543 transaction pooler (see DEPLOYMENT.md):
#   postgres://postgres.<ref>:<enc-pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
Secret=geohod-quest-database-url,type=env,target=DATABASE_URL
# Shared secret enabling the admin telemetry endpoints (fail-closed if unset).
Secret=geohod-quest-admin-token,type=env,target=ADMIN_TOKEN
# Media storage → Cloudflare R2 (see the R2 runbook in DEPLOYMENT.md). The
# identifiers are plain config; the two S3 API-token keys are podman secrets. All
# five must be present for production R2 — otherwise the API falls back to
# in-process media (uploads would not survive a restart).
Environment=R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
Environment=R2_BUCKET=geohod-quest-media
Environment=R2_PUBLIC_BASE_URL=https://media.quest.geohod.ru
Secret=geohod-quest-r2-access-key-id,type=env,target=R2_ACCESS_KEY_ID
Secret=geohod-quest-r2-secret-access-key,type=env,target=R2_SECRET_ACCESS_KEY

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
