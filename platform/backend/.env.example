# Copy to .env (gitignored). Without DATABASE_URL the server runs in-memory (non-durable).
#
# Local dev → the docker-compose Postgres (the default below). Start it with:
#   docker compose up -d postgres   (from platform/)
DATABASE_URL=postgres://geohod:geohod@localhost:5432/geohod
#
# Production → Supabase (managed Postgres). Use the SESSION-mode pooler: NOT the
# direct db.<ref>.supabase.co host (IPv6-only), and NOT the :6543 transaction
# pooler (it breaks sqlx prepared statements + migration advisory locks). TLS is
# required, so keep ?sslmode=require. URL-encode special chars in the password (a
# raw : / @ + corrupts URL parsing). Copy the exact host/region from the Supabase
# dashboard -> Connect -> Session pooler:
#   DATABASE_URL=postgres://postgres.<ref>:<enc-pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Connection-pool cap (default 5). Keep modest so multiple instances stay within
# the managed pooler's budget; raise for a larger DB/instance.
# DB_MAX_CONNECTIONS=5
# PORT=8080

# Shared secret for admin-only endpoints (per-version stats/feedbacks, legacy
# migration). When unset those endpoints are DISABLED (fail-closed). The internal
# admin UI sends it via the frontend NEXT_PUBLIC_ADMIN_TOKEN env (must match).
# ADMIN_TOKEN=change-me-to-a-long-random-secret

# CORS allowlist (comma-separated). Each entry is an exact origin or a single-*
# wildcard. When UNSET, CORS reflects ANY origin (dev convenience) — production
# MUST set this. Example:
# CORS_ALLOWED_ORIGINS=https://app.quest.geohod.ru,https://*.vercel.app

# Media storage → Cloudflare R2 (production). Quest images are stored
# content-addressed (sha256) in R2; the quest JSON carries public URLs and players
# read media DIRECTLY from R2 via the custom domain — never through the API. When
# ALL FIVE R2_* below are set the backend uses R2; if any is missing it falls back
# to an in-process store that serves uploads at /api/media/<hash> (fine for local
# dev/tests, non-durable). See the R2 runbook in DEPLOYMENT.md.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=...            # R2 S3 API token: access key id
# R2_SECRET_ACCESS_KEY=...        # R2 S3 API token: secret access key (keep secret)
# R2_BUCKET=geohod-quest-media
# R2_PUBLIC_BASE_URL — base media URLs are built from ("{base}/{hash}"), baked into
# stored quest JSON, so it MUST match the import's value exactly. Two modes:
#   * custom domain bound to the bucket:   https://media.quest.geohod.ru
#   * no custom domain — serve via the API: https://api.quest.geohod.ru/api/media
#     (the API streams bytes from R2 at GET /api/media/{hash}; no Cloudflare domain
#     or bucket CORS needed — the backend's own CORS allowlist covers it).
# R2_PUBLIC_BASE_URL=https://api.quest.geohod.ru/api/media
#
# R2_ENDPOINT — optional S3 endpoint override; ONLY for pointing at a local S3 mock
# (MinIO) in tests. Leave unset in production (defaults to the R2 account endpoint).
#
# Local dev WITHOUT R2: the in-process store builds refs against this base so the
# browser can fetch cross-origin from the API (default http://localhost:8080/api/media).
# MEDIA_PUBLIC_BASE_URL=http://localhost:8080/api/media

# Transactional mail (password reset / email confirmation). When SMTP_URL is
# unset, mails are LOGGED instead of sent (dev/staging fallback — links still
# appear in the server log). The whole credential lives in the URL; URL-encode
# special chars (Beget's login is the full mailbox address, so its @ MUST be
# %40; same for : / @ + in the password):
#   implicit TLS (port 465):  SMTP_URL=smtps://no-reply%40geohod.ru:<enc-pw>@smtp.beget.com:465
#   STARTTLS   (port 587):    SMTP_URL=smtp://no-reply%40geohod.ru:<enc-pw>@smtp.beget.com:587?tls=required
# SMTP_URL=
# From header; the mailbox part must be a sender the SMTP account may use.
# MAIL_FROM=GEOHOD QUEST <no-reply@geohod.ru>
# Public frontend origin baked into emailed links (default http://localhost:3000).
# FRONTEND_BASE=https://app.quest.geohod.ru

# ---- Social sign-in (Google + Telegram) ----
# Each provider is fail-closed: when its var is unset the corresponding endpoint
# (/api/auth/google, /api/auth/telegram) returns 501 and the button is hidden.
#
# Google — "Sign in with Google" (Google Identity Services). Create an OAuth 2.0
# Web client in Google Cloud Console; add your frontend origin to "Authorized
# JavaScript origins". The backend verifies the ID token's signature (Google JWKS)
# and requires aud == this client id. The frontend fetches this (public) id from
# GET /api/auth/providers to render the button — no separate frontend env needed.
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
#
# Telegram — OpenID Connect login (core.telegram.org/bots/telegram-login), the
# modern replacement for the legacy HMAC Login Widget. In @BotFather open Bot
# Settings > Web Login and register your Allowed URLs (frontend origin + the OIDC
# redirect); BotFather then shows a Client ID. The frontend loads telegram-login.js
# and calls Telegram.Login with this (public) Client ID; the backend verifies the
# returned id_token against Telegram's public JWKS and requires aud == this id. No
# bot token/secret is needed for verification (asymmetric JWKS). The frontend reads
# this id from GET /api/auth/providers to render the button.
# TELEGRAM_CLIENT_ID=1234567890
