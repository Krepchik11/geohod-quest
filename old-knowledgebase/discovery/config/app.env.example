# Bubble.io Discovery Configuration
# Copy to app.env and fill in values. NEVER commit app.env.

# App base URL (no trailing slash)
BUBBLE_BASE_URL=https://yourapp.bubbleapps.io

# Environment: live | dev
BUBBLE_ENV=dev

# Admin API token from Settings → API
BUBBLE_API_TOKEN=

# Optional: custom domain if different from bubbleapps.io
# BUBBLE_CUSTOM_DOMAIN=https://yourdomain.com

# Comma-separated list of data type API names (lowercase, as in Data API URL)
# Example: user,order,product,payment_log
BUBBLE_DATA_TYPES=

# Comma-separated list of exposed API workflow names
# Example: signup,process_webhook,get_catalog
BUBBLE_API_WORKFLOWS=

# Path to downloaded .bubble file (paid plan export)
BUBBLE_APP_FILE=../raw/exports/bubble_file/yourapp.bubble

# Safety: set to true only on dev/sandbox to allow POST workflow probes
ALLOW_WRITE_PROBES=false

# Rate limit: ms to wait between API calls
API_DELAY_MS=200

# Max records to fetch per type (0 = no limit up to Bubble plan cap)
MAX_RECORDS_PER_TYPE=0