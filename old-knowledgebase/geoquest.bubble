llapse_when_hidden":true},"type":"Group","id":"bTMXp","default_name":"Group RZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":" Ограничения зависят от сложности маршрута, но бывают и другие факторы. Обязательно обсудите этот момент с координатором. В среднем верхняя граница для походников 60–70 лет, а дальше по согласованию с инструктором. Если вы бодры душой и телом, то для вас найдётся свой маршрут!            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMXq","default_name":"Text HZZ"}},"name":"Group Hidden_I_am_60_years_old_and_I_want_to_go_hiking","style":"Group_default_group_"}},"name":"Group I_am_60_years_old_and_I_want_to_go_hiking","order":8},"bTMYh":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":18,"border_roundness":10,"is_visible":false,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":4,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-start","container_layout":"column","collapse_when_hidden":true},"states":{"1":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"},"min_width_css":"0px"},"type":"State"}},"type":"Group","id":"bTMYA","current_parent":"bTMJj.elements","default_name":"Group SZZZ","elements":{"bTMOF":{"properti