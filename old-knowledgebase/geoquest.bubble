t_height":true,"font_family":"Rubik","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"94%","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMYv","default_name":"Text KZZ"},"bTMOM":{"properties":{"height":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMYx"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMYw","default_name":"Group XZZZ","name":"Group Hidden_open_Why_do_I_need_it?_2"}},"name":"Group Text_and_hidden_group_why_do_I_need_it?"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMYx","default_name":"Group XZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":"В походах каждый находит что-то своё. Труженики жаждут отдыха, смены обстановки и тишины, которую можно прочувствовать только на природе. Активные, сильные и независимые едут за интересным отпуском и новыми впечатлениями. Куда до походов бесцельному валянию на курортных пляжах! Общительные хотят завести новых друзей или даже найти своё «долго и счастливо» — в приключениях сразу понятно, кто с тобой будет и в горе, и в радости. Семьянины желают провести время с детьми и сплотиться. Экстремалы бросают себе вызов, жаждут адреналина и хотят проверить себя на прочность. Ценители прекрасного желают восхититься дивной природой и увидеть уголки, недоступные тем, кто выбирает «всё включено». В заповедные места можно только прийти пешком, с рюкзаком за плечами! Кто-то уже давно «заболел» походами и не хочет останавливаться. А для кого-то походы — это и есть жизнь. Среди множества приключений на сайте каждый сможет найти себе вариант по душе!             "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMYy","default_name":"Text KZZ"}},"name":"Group Hidden_why_do_I_need_it?","style":"Group_default_group_"}},"name":"Group Why_do_I_need_it?","order":7},"bTMYY":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":12,"border_roundness":10,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":2,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-start","container_layout":"column"},"states":{"1":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"},"min_width_css":"0px"},"type":"State"}},"type":"Group","id":"bTMYz","current_parent":"bTMJj.elements","default_name":"Group XZZZ","elements":{"bTMOF":{"properties":{"height":3,"left":0,"top":0,"width":100,"zindex":2,"background_style":"none","order":1,"fit_height":true,"single_width":true,"margin_bottom":32,"min_width_css":"100%","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"row","container_horiz_alignment":"space-between"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMZD"},"type":"GetElement","said":"Z2VvcXVlc3Q="},"properties":{"margin_bottom":0},"type":"State"}},"type":"Group","id":"bTMZA","default_name":"Group XZZZ","elements":{"bTMOJ":{"properties":{"text":{"entries":{"0":"Что делать если мне нужно вернуться раньше или приехать позже ?"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":2,"left":0,"top":0,"width":16,"zindex":3,"font_color":"rgba(35,35,35,1)","font_size":18,"line_height":1,"order":1,"fit_width":true,"fit_height":true,"font_family":"Rubik","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"94%","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMZB","default_name":"Text KZZ"},"bTMOM":{"properties":{"height":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMZD"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMZC","default_name":"Group XZZZ","name":"Group Hidden_open_What_to_do_if_I_need_to_be_back_earlier_or_arrive_later_2"}},"name":"Group Text_and_hidden_group_what_to_do_if_I_need_to_be_back_earlier_or_arrive_later"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMZD","default_name":"Group XZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":"Лучше всего обсудить этот вопрос с инструктором через координатора заранее, до бронирования места в походе. Большинство маршрутов завязаны на предоставляемый трансфер, а также нужно учитывать удалённость от населенных пунктов, трафик, местность, тип маршрута и т. д., так что уехать раньше или приехать позже вряд ли получится, либо придётся добираться за свой счёт.            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMZE","default_name":"Text KZZ"}},"name":"Group Hidden_what_to_do_if_I_need_to_be_back_earlier_or_arrive_later","style":"Group_default_group_"}},"name":"Group What_to_do_if_I_need_to_be_back_earlier_or_arrive_later","order":3},"bTMYZ":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":13,"border_roundness":10,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":3,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-start","container_layout":"column"},"states":{"1":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"},"min_width_css":"0px"},"type":"State"}},"type":"Group","id":"bTMZF","current_parent":"bTMJj.elements","default_name":"Group XZZZ","elements":{"bTMOF":{"properties":{"height":3,"left":0,"top":0,"width":100,"zindex":2,"background_style":"none","order":1,"fit_height":true,"single_width":true,"margin_bottom":32,"min_width_css":"100%","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"row","container_horiz_alignment":"space-between"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMZJ"},"type":"GetElement","said":"Z2VvcXVlc3Q="},"properties":{"margin_bottom":0},"type":"State"}},"type":"Group","id":"bTMZG","default_name":"Group XZZZ","elements":{"bTMOJ":{"properties":{"text":{"entries":{"0":"Можно ли идти в поход если есть ограничения по состоянию здоровья,  хронические заболевания, группа инвалидности?"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":2,"left":0,"top":0,"width":16,"zindex":3,"font_color":"rgba(35,35,35,1)","font_size":18,"line_height":1,"order":1,"fit_width":true,"fit_height":true,"font_family":"Rubik","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"94%","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMZH","default_name":"Text KZZ"},"bTMOM":{"properties":{"height":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMZJ"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMZI","default_name":"Group XZZZ","name":"Group Hidden_open_Is_it_possible_to_go_hiking_if_there_are_health_restrictions?_2"}},"name":"Group Text_and_hidden_group_Is_it_possible_to_go_hiking_if_there_are_health_restrictions?"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMZJ","default_name":"Group XZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":"Всё строго индивидуально, обязательно обсудите маршрут и нагрузку с лечащим врачом и согласуйте с инструктором. Походы — это активный отдых, поэтому сложные путешествия не всегда подойдут для тех, у кого есть заболевания опорно-двигательного аппарата, также не должно быть проблем со спиной, коленями, сердцем, дыханием.\n\nДля некоторых приключений требуется опыт и хорошая физическая форма, но есть и лёгкие маршруты. Они доступны большинству людей, поэтому всегда можно подобрать для себя лучший вариант.\n\nРекомендуем трезво оценивать свои силы и согласовывать спорные моменты с координаторами. Ни в коем случае не скрывайте от координатора состояние здоровья, ведь именно это позволит сделать путешествие максимально комфортным и приятным.\n            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMZK","default_name":"Text KZZ"}},"name":"Group Hidden_Is_it_possible_to_go_hiking_if_there_are_health_restrictions?","style":"Group_default_group_"}},"name":"Group Is_it_possible_to_go_hiking_if_there_are_health_restrictions?","order":4},"bTMYa":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":14,"border_roundness":10,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":4,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-start","container_layout":"column"},"states":{"1":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"},"min_width_css":"0px"},"type":"State"}},"type":"Group","id":"bTMZL","current_parent":"bTMJj.elements","default_name":"Group XZZZ","elements":{"bTMOF":{"properties":{"height":3,"left":0,"top":0,"width":100,"zindex":2,"background_style":"none","order":1,"fit_height":true,"single_width":true,"margin_bottom":32,"min_width_css":"100%","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"row","container_horiz_alignment":"space-between"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMZP"},"type":"GetElement","said":"Z2VvcXVlc3Q="},"properties":{"margin_bottom":0},"type":"State"}},"type":"Group","id":"bTMZM","default_name":"Group XZZZ","elements":{"bTMOJ":{"properties":{"text":{"entries":{"0":"У меня нет своего снаряжения. Можно взять в аренду рюкзак, палатку, лыжи и другие полезные вещи ?"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":2,"left":0,"top":0,"width":16,"zindex":3,"font_color":"rgba(35,35,35,1)","font_size":18,"line_height":1,"order":1,"fit_width":true,"fit_height":true,"font_family":"Rubik","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"94%","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMZN","default_name":"Text KZZ"},"bTMOM":{"properties":{"height":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMZP"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMZO","default_name":"Group XZZZ","name":"Group Hidden_open_ I_don't_have_equipment_2"}},"name":"Group Text_and_hidden_group_I_don't_have_equipment"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMZP","default_name":"Group XZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":"Не у каждого дома лежит набор походника на все случаи жизни и погодные условия, особенно если вы пока новичок в этих делах. Разное недостающее снаряжение можно взять в аренду под залог в наших офисах в Москве и Санкт-Петербурге за определённую плату. Координатор похода расскажет вам, какое снаряжение подойдёт для вашего типа похода, а сотрудники офиса подберут нужный размер, например, лыж. Арендованные вещи нужно будет самостоятельно забрать и привезти обратно после возвращения в город. Взять снаряжение в аренду могут только участники походов с «Клубом Приключений».            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMZQ","default_name":"Text KZZ"}},"name":"Group Hidden_I_don't_have_equipment","style":"Group_default_group_"}},"name":"Group I_don't_have_equipment","order":5}},"name":"Group Left_4_point_faq"},"bTMYm":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":20,"background_style":"none","order":2,"fit_height":true,"padding_top":10,"padding_left":10,"single_width":false,"min_width_css":"0px","padding_right":10,"single_height":false,"min_height_css":"0px","padding_bottom":10,"ho