:"State"}},"type":"Group","id":"bTMYE","default_name":"Group SZZZ","name":"Group Hidden_open_How_to_pack_a_backpack?"}},"name":"Group Text_and_hidden_group_How_to_pack_a_backpack?"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column"},"type":"Group","id":"bTMYF","default_name":"Group SZZZ","elements":{"bTMYS":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":8,"background_style":"none","order":1,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"column"},"type":"Group","id":"bTMYQ","default_name":"Group TZZZ","elements":{"bTMYT":{"properties":{"text":{"entries":{"0":" Упаковать рюкзак не так уж и сложно, просто следуйте этой памятке. Самое главное — тяжёлые предметы располагайте поближе к спине и не слишком низко, где-то на уровне лопаток. Спальник лучше уложить на самое дно, а мелкие пустоты тоже заполнить мягкими вещами для компактности.\n\nОбщественное снаряжение — это инвентарь, которым будут пользоваться в походе несколько или даже все участники плюс еда и продукты. Это то, без чего не прожить в походе и не организовать походный быт. Обычно это палатки, продукты, котлы и костровое снаряжение, тент от дождя, топор, аптечка, ремонтный набор. Иногда требуется забрать общак перед походом, (это всегда заранее согласует координатор), а также инструктор может попросить вернуть что-то из общака обратно. \n\nОбщественное снаряжение делится между всеми участниками, каждая часть весит 3–7 кг и занимает около 1/3 рюкзака. Если ваши личные вещи занимают более 2/3 рюкзака, лучше пересмотреть всё, что берёте с собой, с учётом объёма общака.             "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMYG","default_name":"Text IZZ"}},"style":"Group_default_group_"}},"name":"Group Hidden_How_to_pack_a_backpack?","style":"Group_default_group_"}},"name":"Group How_to_pack_a_backpack?","order":9}},"name":"Group Right_4_point_faq"}},"name":"Group 8_point_ORGANIZATIONAL_MATTERS"},"bTMYp":{"properties":{"text":{"entries":{"0":"ОБЩИЕ ВОПРОСЫ"},"type":"TextExpression"},"font_face":"Catallina:::custom","height":28,"left":0,"top":0,"width":196,"zindex":22,"font_alignment":"center","font_color":"rgba(35, 35, 35, 1)","font_size":28,"order":3,"fit_width":true,"fit_height":true,"margin_top":0,"font_family":"Rubik","font_weight":"500","single_width":false,"margin_bottom":50,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center"},"type":"Text","id":"bTMYn","current_parent":"bTMJj.elements","default_name":"Text JZZ","order":8},"bTMZr":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":23,"background_style":"none","order":4,"fit_height":true,"single_width":false,"max_width_css":"1366px","min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"row"},"type":"Group","id":"bTMYq","current_parent":"bTMJj.elements","default_name":"Group XZZZ","elements":{"bTMYl":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":19,"background_style":"none","order":1,"fit_height":true,"padding_top":10,"padding_left":10,"single_width":false,"min_width_css":"0px","padding_right":10,"single_height":false,"min_height_css":"0px","padding_bottom":10,"horiz_alignment":"flex-start","container