ssage","name":"is_true","is_slidable":false},"properties":{"name":"Page Loaded (Entire)"},"type":"PageData","is_slidable":false},"properties":{"html":{"entries":{"0":{"properties":{"arbitrary_text":{"entries":{"0":"<!DOCTYPE html>\n<html>\n<body>\n    <div id=\"map\"></div>\n    <script>\n(function() {\n    // Функция для очистки существующей карты\n    function cleanupExistingMap() {\n        if (window.mapInstance) {\n            // Удаляем все маркеры\n            if (window.markers) {\n                Object.values(window.markers).forEach(marker => marker.remove());\n                window.markers = {};\n            }\n\n            // Удаляем все слои и источники\n            if (window.mapInstance.getLayer('route')) {\n                window.mapInstance.removeLayer('route');\n            }\n            if (window.mapInstance.getSource('route')) {\n                window.mapInstance.removeSource('route');\n            }\n            if (window.mapInstance.getLayer('radius-circle-fill')) {\n                window.mapInstance.removeLayer('radius-circle-fill');\n            }\n            if (window.mapInstance.getLayer('radius-circle-border')) {\n                window.mapInstance.removeLayer('radius-circle-border');\n            }\n            if (window.mapInstance.getSource('radius-circle')) {\n                window.mapInstance.removeSource('radius-circle');\n            }\n\n            // Удаляем элементы управления\n            window.mapInstance.removeControl(window.mapInstance.navigationControl);\n            window.mapInstance.removeControl(window.mapInstance.fullscreenControl);\n\n            // Уничтожаем карту\n            window.mapInstance.remove();\n            window.mapInstance = null;\n        }\n    }\n\n// Функция для обработки изменения размера окна\nfunction handleMapResize() {\n    if (!window.mapInstance) {\n        console.error('Карта не инициализирована');\n        return;\n    }\n\n    // Функция для эффективной обработки ресайза (debounce)\n    let resizeTimeout;\n    const debouncedResize = () => {\n        clearTimeout(resizeTimeout);\n        resizeTimeout = setTimeout(() => {\n            try {\n                window.mapInstance.resize();\n                console.log('Размер карты обновлен');\n            } catch (error) {\n                console.error('Ошибка при обновлении размера карты:', error);\n            }\n        }, 100); // Задержка в 100мс для оптимизации производительности\n    };\n\n    // Добавляем слушатель события resize\n    window.addEventListener('resize', debouncedResize);\n\n    // Добавляем удаление обработчика в функцию очистки\n    const originalCleanup = window.cleanupExistingMap;\n    window.cleanupExistingMap = function() {\n        window.removeEventListener('resize', debouncedResize);\n        clearTimeout(resizeTimeout);\n        if (originalCleanup) {\n            originalCleanup();\n        }\n    };\n}\n\n    // Очищаем существующую карту\n    cleanupExistingMap();\n\n    console.log('Создаем новую карту');\n    mapboxgl.accessToken = 'pk.eyJ1IjoiZXBlc3RvdiIsImEiOiJjbTV0a3VwYWMweG9iMmpxdWw3eXRycjA0In0.AxIp0-BCI_vgzBfC59T9PA';\n    \n    window.mapInstance = new mapboxgl.Map({\n        container: 'map',\n        style: 'mapbox://styles/epestov/cm5tl1fqr002001sbbmwwbngp',\n        center: [","1":{"properties":{"arbitrary_text":{"entries":{"0":"","1":{"next":{"next":{"type":"Message","name":"format_number","is_slidable":true},"type":"Message","name":"longitude_number","is_slidable":false},"type":"ElementParent","is_slidable":false},"2":", ","3":{"next":{"next":{"type":"Message","name":"format_number","is_slidable":true},"type":"Message","name":"latitude_number","is_slidable":false},"type":"ElementParent","is_slidable":false},"4":""},"type":"TextExpression"}},"type":"ArbitraryText","said":"Z2VvcXVlc3Q="},"2":"],\n        zoom: 12\n    });\n\n    window.mapInstance.addControl(new mapboxgl.NavigationControl());\n    window.mapInstance.addControl(new mapboxgl.FullscreenControl());\n\n    // Инициализация глобальных переменных\n    if (!window.markers) {\n        window.markers = {};\n    }\n    \n    if (typeof window.radiusCircle === 'undefined') {\n        window.radiusCircle = null;\n    }\n\n    // Добавляем обработчики событий\n    window.mapInstance.on('error', function(e) {\n        console.error('Map error:', e);\n    });\n\n    window.mapInstance.on('style.load', function() {\n        console.log('Style loaded successfully');\n    });\n\n    // Регистрация функций только если они еще не существуют\n    if (!window.addMarker) {\n        window.addMarker = function(id, lng, lat, color = 'blue', imageUrl = null) {\n            let marker;\n            if (imageUrl) {\n                const markerElement = document.createElement('div');\n                markerElement.style.backgroundImage = `url(${imageUrl})`;\n                markerElement.style.backgroundSize = 'cover';\n                markerElement.style.width = '36px';\n                markerElement.style.height = '36px';\n                markerElement.style.borderRadius = '50%';\n\n                marker = new mapboxgl.Marker({ element: markerElement })\n                    .setLngLat([lng, lat])\n                    .addTo(window.mapInstance);\n            } else {\n                marker = new mapboxgl.Marker({ color: color })\n                    .setLngLat([lng, lat])\n                    .addTo(window.mapInstance);\n            }\n            window.markers[id] = marker;\n        };\n    }\n\n    if (!window.removeMarker) {\n        window.removeMarker = function(id) {\n            if (window.markers[id]) {\n                window.markers[id].remove();\n                delete window.markers[id];\n            } else {\n                console.warn(`Маркер с id \"${id}\" не найден.`);\n            }\n        };\n    }\n\n    if (!window.updateMarkerCoordinates) {\n        window.updateMarkerCoordinates = function(id, lng, lat) {\n            const marker = window.markers[id];\n            if (marker) {\n                marker.setLngLat([lng, lat]);\n            } else {\n                console.log(`Маркер с id ${id} не найден.`);\n            }\n        };\n    }\n\n    if (!window.buildRoute) {\n        window.buildRoute = function(id1, id2) {\n            const marker1 = window.markers[id1];\n            const marker2 = window.markers[id2];\n\n            if (marker1 && marker2) {\n                const coords1 = marker1.getLngLat().toArray();\n                const coords2 = marker2.getLngLat().toArray();\n\n                const url = `https://api.mapbox.com/directions/v5/mapbox/walking/${coords1[0]},${coords1[1]};${coords2[0]},${coords2[1]}?geometries=geojson&access_token=${mapboxgl.accessToken}`;\n                \n                fetch(url)\n                    .then(response => response.json())\n                    .then(data => {\n                        const route = data.routes[0].geometry;\n\n                        if (window.mapInstance.getLayer('route')) {\n                            window.mapInstance.removeLayer('route');\n                            window.mapInstance.removeSource('route');\n                        }\n\n                        window.mapInstance.addSource('route', {\n                            type: 'geojson',\n                            data: {\n                                type: 'Feature',\n                                geometry: route,\n                            },\n                        });\n\n                        window.mapInstance.addLayer({\n                            id: 'route',\n                            type: 'line',\n                            source: 'route',\n                            layout: {\n                                'line-join': 'round',\n                                'line-cap': 'round',\n                            },\n                            paint: {\n                                'line-color': '#0074D9',\n                                'line-width': 4,\n                            },\n                        });\n                    })\n                    .catch(error => console.error('Ошибка построения маршрута:', error));\n            } else {\n                console.log('Один или оба маркера не найдены');\n            }\n        };\n    }\n\n    if (!window.removeRadius) {\n        window.removeRadius = function() {\n            if (window.mapInstance.getLayer('radius-circle-fill')) {\n                window.mapInstance.removeLayer('radius-circle-fill');\n            }\n            \n            if (window.mapInstance.getLayer('radius-circle-border')) {\n                window.mapInstance.removeLayer('radius-circle-border');\n            }\n            \n            if (window.mapInstance.getSource('radius-circle')) {\n                window.mapInstance.removeSource('radius-circle');\n            }\n\n            window.radiusCircle = null;\n        };\n    }\n\n    if (!window.removeRoute) {\n        window.removeRoute = function() {\n            if (window.mapInstance.getLayer('route')) {\n                window.mapInstance.removeLayer('route');\n            }\n            \n            if (window.mapInstance.getSource('route')) {\n                window.mapInstance.removeSource('route');\n            }\n        };\n    }\n\n    if (!window.createRadius) {\n        window.createRadius = function(centerIndex, radiusKm) {\n            if (!window.markers[centerIndex]) return;\n\n            const center = window.markers[centerIndex].getLngLat();\n            const options = {\n                steps: 64,\n                units: 'kilometers'\n            };\n\n            const circle = turf.circle([center.lng, center.lat], radiusKm, options);\n\n            if (window.radiusCircle) {\n                window.removeRadius();\n            }\n\n            window.mapInstance.addSource('radius-circle', {\n                'type': 'geojson',\n                'data': circle\n            });\n\n            window.mapInstance.addLayer({\n                'id': 'radius-circle-fill',\n                'type': 'fill',\n                'source': 'radius-circle',\n                'paint': {\n                    'fill-color': '#3887be',\n                    'fill-opacity': 0.2\n                }\n            });\n\n            window.mapInstance.addLayer({\n                'id': 'radius-circle-border',\n                'type': 'line',\n                'source': 'radius-circle',\n                'paint': {\n                    'line-color': '#3887be',\n                    'line-width': 2\n                }\n            });\n\n            window.radiusCircle = circle;\n        };\n    }\n\n    if (!window.checkPointInRadius) {\n        window.checkPointInRadius = function(pointIndex) {\n            if (!window.radiusCircle || !window.markers[pointIndex]) return false;\n\n            const point = window.markers[pointIndex].getLngLat();\n            const pt = turf.point([point.lng, point.lat]);\n\n            const isInRadius = turf.booleanPointInPolygon(pt, window.radiusCircle);\n\n            if (isInRadius) {\n                document.querySelector(\"#openPopup\").click();\n            }\n\n            return isInRadius;\n        };\n    }\n\n// Функция для перемещения карты к заданным координатам\nfunction flyToLocation(coordinates, zoom = 14) {\n    if (!window.mapInstance) {\n        console.error('Карта не инициализирована');\n        return;\n    }\n\n    try {\n        // Проверяем валидность координат\n        if (!Array.isArray(coordinates) || coordinates.length !== 2 || \n            !isFinite(coordinates[0]) || !isFinite(coordinates[1])) {\n            throw new Error('Неверный формат координат');\n        }\n\n        window.mapInstance.flyTo({\n            center: coordinates,\n            zoom: zoom,\n            duration: 2000, // Длительность анимации в миллисекундах\n            essential: true, // Гарантирует выполнение анимации даже при низкой производительности\n            curve: 1.42, // Кривая анимации для плавного движения\n            easing: (t) => t // Линейная функция плавности\n        });\n\n        // Добавляем обработчик для отслеживания завершения анимации\n        window.mapInstance.once('moveend', () => {\n            console.log('Перемещение завершено');\n        });\n\n    } catch (error) {\n        console.error('Ошибка при перемещении карты:', error);\n    }\n}\n\nwindow.flyToLocation = flyToLocation;\n\nhandleMapResize();\n\nfunction forceMapResize() {\n    if (!window.mapInstance) {\n        console.error('Карта не инициализирована');\n        return;\n    }\n\n    try {\n        window.mapInstance.resize();\n        console.log('Размер карты обновлен');\n    } catch (error) {\n        console.error('Ошибка при обновлении размера карты:', error);\n    }\n}\n\n// Добавляем функцию в глобальный объект window для доступа из других частей приложения\nwindow.forceMapResize = forceMapResize;\n\n    return window.mapInstance;\n})();\n\n</script>\n</body>\n</html>"},"type":"TextExpression"}},"type":"ArbitraryText"}},"type":"TextExpression"}},"type":"State"}},"properties":{"height":150,"left":10,"top":10,"width":280,"zindex":5,"html":{"entries":{"0":""},"type":"TextExpression"},"is_visible":true,"padding_horizontal":4,"padding_vertical":4,"useiframe":false,"vertical_centering":true,"order":2,"fit_height":false,"padding_top":0,"padding_left":0,"single_width":true,"min_width_css":"100%","padding_right":0,"single_height":true,"min_height_css":"100%","padding_bottom":0,"horiz_alignment":"flex-start","nonant_alignment":"bb","collapse_when_hidden":false},"type":"HTML","id":"bTVLY","current_parent":"bTVHI","default_name":"HTML A","name":"HTML Mapbox"},"bTVNa":{"properties":{"height":47,"left":0,"top":0,"width":320,"zindex":10,"border_color":"rgba(62,44,44,1)","border_roundness":24,"border_width":2,"data_source":{"type":"ElementParent","is_slidable":false},"group_type":"custom.page_constructor","is_