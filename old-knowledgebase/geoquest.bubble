:"0px","padding_bottom":0,"horiz_alignment":"flex-start","nonant_alignment":"ba"},"type":"Text","id":"bTKbD","default_name":"Text A"},"bTKbI":{"properties":{"text":{"entries":{"0":"Наш квест — это экскурсионный маршрут в виде игры с загадками. Он проведет вас по живописным и историческим местам, расскажет интересную историю и поблагодарит за правильные ответы.\n\nЗадания квеста не требуют специальных знаний, достаточно логично мыслить, ориентироваться на местности и быть в хорошем настроении).\n\nЕсли допустите ошибку – не беда, количество попыток не ограничено.\nЗа каждое пройдённое задание вам начисляются баллы. Их можно потратить на подсказки или правильные ответы.\n\nДля навигации и поиска объектов квеста можно использовать встроенную карту. Баллы в этом случае не тратятся, но, если вы любите играть на «харде» попробуйте обойтись без нее.\n\nУдачной игры!\n"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":54,"left":153,"top":68,"width":86,"zindex":3,"font_color":"rgba(62,44,44,1)","font_size":15,"line_height":1.3,"fit_width":true,"fit_height":true,"margin_top":44,"font_family":"Inter","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"330px","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start","nonant_alignment":"ba"},"type":"Text","id":"bTKbG","current_parent":"bTKao.elements","default_name":"Text B"},"bTUdc":{"properties":{"height":24,"left":0,"top":0,"width":24,"zindex":2,"background_style":"image","background_image":{"entries":{"0":"//8ebd72cadc76b45bfef67590b0ca2d5f.cdn.bubble.io/f1686402732954x786376006843780000/Group%20113.svg"},"type":"TextExpression"},"fit_height":true,"margin_left":0,"margin_right":12,"single_width":true,"min_width_css":"26px","single_height":false,"min_height_css":"14px","horiz_alignment":"flex-start","nonant_alignment":"ca"},"type":"Group","id":"bTUda","current_parent":"