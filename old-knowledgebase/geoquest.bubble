ht":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMZo"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMZn","default_name":"Group XZZZ","name":"Group Hidden_open_How_to_pack_a_backpack?_2"}},"name":"Group Text_and_hidden_group_How_to_pack_a_backpack?"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMZo","default_name":"Group XZZZ","elements":{"bTMYS":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":8,"background_style":"none","order":1,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"column"},"type":"Group","id":"bTMZp","default_name":"Group XZZZ","elements":{"bTMYT":{"properties":{"text":{"entries":{"0":" Упаковать рюкзак не так уж и сложно, просто следуйте этой памятке. Самое главное — тяжёлые предметы располагайте поближе к спине и не слишком низко, где-то на уровне лопаток. Спальник лучше уложить на самое дно, а мелкие пустоты тоже заполнить мягкими вещами для компактности.\n\nОбщественное снаряжение — это инвентарь, которым будут пользоваться в походе несколько или даже все участники плюс еда и продукты. Это то, без чего не прожить в походе и не организовать походный быт. Обычно это палатки, продукты, котлы и костровое снаряжение, тент от дождя, топор, аптечка, ремонтный набор. Иногда требуется забрать общак перед походом, (это всегда заранее согласует координатор), а также инструктор может попросить вернуть что-то из общака обратно. \n\nОбщественное снаряжение делится между всеми участниками, каждая часть весит 3–7 кг и занимает около 1/3 рюкзака. Если ваши личные вещи занимают более 2/3 рюкзака, лучше пересмотреть всё, что берёте с собой, с учётом объёма общака.             "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMZq","default_name":"Text KZZ"}},"style":"Group_default_group_"}},"name":"Group Hidden_How_to_pack_a_backpack?","style":"Group_default_group_"}},"name":"Group How_to_pack_a_backpack?","order":9}},"name":"Group Right_4_point_faq"}},"name":"Group 8_point_GENERAL_ISSUES","order":4}},"properties":{"height":50,"left":0,"top":0,"width":45,"zindex":4,"is_visible":false,"background_style":"none","order":1,"fit_height":true,"padding_top":80,"single_width":false,"min_width_css":"360px","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"column","nonant_alignment":"ba","collapse_when_hidden":true},"states":{"0":{"condition":{"next":{"args":"faq","type":"Message","name":"equals"},"properties":{"parameter_name":{"entries":{"0":"screen"},"type":"TextExpression"}},"type":"GetParamF