me":"Group A","elements":{"bTLBF":{"properties":{"height":34,"left":12,"top":141,"width":322,"zindex":1,"background_style":"none","fit_width":false,"fit_height":true,"margin_left":12,"margin_right":12,"padding_left":0,"single_width":false,"max_width_css":"1240px","min_width_css":"0px","single_height":false,"min_height_css":"33.5859375px","horiz_alignment":"flex-start","container_layout":"relative","nonant_alignment":"bb"},"states":{"0":{"condition":{"next":{"args":1240,"type":"Message","name":"less_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"nonant_alignment":"ab"},"type":"State"}},"type":"Group","id":"bTLBD","default_name":"Group B","elements":{"bTLBG":{"properties":{"text":{"entries":{"0":"ДИСКЛЕЙМЕР"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":59,"left":-24,"top":-142,"width":215,"zindex":2,"font_color":"rgba(255,255,255,1)","font_size":26,"line_height":1.2,"fit_width":true,"fit_height":true,"font_family":"Catallina:::custom","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"380px","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start","nonant_alignment":"ab"},"states":{"0":{"condition":{"next":{"args":560,"type":"Message","name":"greater_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"}},"type":"State"},"1":{"condition":{"next":{"args":480,"type":"Message","name":"greater_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"font_size":28},"type":"State"},"2":{"condition":{"next":{"args":768,"type":"Message","name":"greater_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"font_size":32},"type":"State"}},"type":"Text","id":"bTLBA","default_name":"Text B"}},"name":"Group Text"},"bTLvL0":{"properties":{"height":100,"left":0,"top":0,"width":149,"zindex":0,"is_visible":false,"src":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1671575508367x775808188220710200/%D0%BF%D1%83%D0%B1%D0%BB%20%D0%BE%D1%84%D0%B5%D1%80%D1%82%D0%B0.jpg"},"type":"TextExpression"},"alt_tag":{"type":"TextExpression"},"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","nonant_alignment":"bb","use_aspect_ratio":false,"aspect_ratio_width":7395,"aspect_ratio_height":4933,"collapse_when_hidden":true},"type":"Image","id":"bTLvJ0","default_name":"Image A"}},"name":"Group Image"},"bTKFY0":{"properties":{"text":{"entries":{"0":"Дисклеймер сайта Geohod.ru \n\n \n\nУсловия пользования \n\n \n\nДанный сайт Geohod.ru  является информационной онлайновой услугой Шестака Сергея Николаевича (действующего как самозанятый, ИНН 500301772477), далее по тексту “Владелец” Пользование сайтом подразумевает подчинение указанным ниже условиям и использование данной услуги в законных целях при соблюдении действующего законодательства и нормативных положений. \n\n  \n\nИнтеллектуальная собственность \n\n \nПользователь признает, что материалы и содержимое данного сайта являются собственностью Владельца, охраняемой авторским правом. Все права защищены. Воспрещается полностью или частично копировать, воспроизводить, изменять, передавать, загружать, скачивать, распространять, транслировать, демонстрировать, перепродавать или публиковать в любом виде приведенные материалы без предварительного письменного согласия Владельца, которая, в свою очередь, имеет право по своему усмотрению не давать согласие. \n\n  \n\nОграничение ответственности \n\n \nДанный сайт предназначен для сообщения точной и соответствующей текущему состоянию информации.Владелец приложит все усилия для того, чтобы представленные на ее сайте сведения полностью соответствовали требованиям в отношении точности и своевременности. Однако, нельзя полностью исключить возможность возникновения непреднамеренных ошибок и упущений. При получении сообщений об ошибках последние будут исправлены. Владелец ни при каких обстоятельствах не несет ответственности за ущерб, убытки, вред всех видов, которые могут понести третьи лица после взаимодействия с данным сайтом. Под информаций понимаются “Городские квесты” данный термин употребляется и понимается так, как он употреблеятся и понимается Владельцем в контексте сайт и его целей. \n\nГородские квесты портала Geohod.ru представляют собой экскурсионные маршруты в виде игры с загадками.   \n\nЛюбой квест совмещает в себе три функции: \n\n1. Экскурсия. Участники квеста посещают достопримечательности города, узнают интересные факты об истории, культуре, архитектуре и т.д.  \n\n2. Активный отдых. Время и маршрут квеста оптимизированы под умеренную физическую нагрузку. Игровое время, как правило — не более 1,5 часа, протяженность маршрута – не более 5 км. Что соответствует при всех прочих равных условиях нулевому уровню риска в туризме, по международным стандартам, при соблюдении условий Городского квеста, правил и норм поведения, в том числе, но не ограничиваясь, нормами законодательства страны в которой непосредственно осуществляется Городской квест, незнания таких норм  Участником (Пользователем) не прикаких условиях не порождает у компании ответственности за Участника и (или) перед ним за любой вид ущерба, включая нематериальный, в том числе кроме прочего и эмоциональный. \n\n3. Развлечение. Сюжетная линия квеста познавательная, динамичная и интригующая: включает резкие повороты событий. \n\n  \n\nСсылки \n\n \nВладелец не несет никакой ответственности за материалы, созданные или опубликованные третьими лицами, гиперактивные ссылки на которых присутствуют на сайте. Пользователи, принимающие решение пройти по ссылке на сайт, посторонний сайту Владельца, делают это на свой риск и принимают на себя ответственность за принятие необходимых мер по защите от компьютерных вирусов и прочих подобных феноменов. \n\nНа данном сайте присутствуют активные ссылки для перехода на другие сайты, что не подразумевает спонсирование или партнерскую принадлежность к организациям, предоставляющим услуги, которые представлены на данных сайтах. \n\n \n\nПолученная информация \n\n \n\n \nВсе сообщения и прочие материалы, отправленные Владельцу по электронной почте или через веб-страницы, не несут конфиденциальный характер. Соответственно, Владелец не несет никаких обязательств в отношении данных материалов и может свободно и бесплатно использовать их, воспроизводить, демонстрировать, преобразовывать, изменять, публиковать или распространять полученное без каких-либо ограничений. При сообщении сведений и предоставлении материалов следует иметь в виду, что данные сведения или материалы могут быть преданы огласке, соглашаясь с тем, что в отношении означенных материалов не может быть возбуждено судебное разбирательство со стороны третьих лиц против Владельца. \n\n  \n\nКуки-файлы \nКуки-файл - это информация, содержащая уникальный анонимный идентификационный код, отправляемый пользователем на браузер с сервера, который затем записывается браузером на жесткий диск пользователя. Куки-файл считывается и распознается веб-сайтом при последующих взаимодействиях самого пользователя с сайтом. Куки-файлы присутствуют на некоторых страницах данного сайта с целью использования информации для отслеживания операций, производимых пользователем на данном сайте. Если вы не хотите получать куки-файлы, вы можете настроить свой браузер таким образом, чтобы он сообщал о получении куки-файла, который можно по своему усмотрению принять или нет. Можно также использовать имеющуюся в браузере функцию отключения всех видов куки-файлов. В обоих случаях могут быть ограничения в доступе к некоторым услугам. \n\n  \n\nПрименимое право и компетентная юрисдикция \n\n \nИнтерпретация и исполнение приведенных терминов регулируются действующим Российским законодательством. Исключительным компетентным органом для разрешения споров всех видов, которые могут возникнуть в результате или в связи с описанными терминами, является Международный коммерческий Арбитражный суд при Торгово-промышленной палате России (Адрес: 109012 Москва, ул. Ильинка, 6/1, c.1 (для почты). Фактический адрес: Москва, ул.Ильинка, д. 5/2)). \n\nВладелец оставляет за собой право предъявлять официальные иски в суды других городов или стран, отличных от указанного, для защиты собственных интересов и отстаивания своих прав. "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":29,"left":0,"top":0,"width":183,"zindex":2,"font_color":"rgba(59, 59, 59, 1)","font_size":14,"line_height":1.2,"order":3,"fit_height":true,"margin_top":60,"font_family":"Inter","font_weight":"400","padding_top":0,"padding_left":12,"single_width":false,"max_width_css":"1240px","min_width_css":"360px","padding_right":12,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"center"},"type":"Text","id":"bTKFW0","default_name":"Text A"}},"name":"Shop_privacy_policy"},"bTKGH0":{"properties":{"height":200,"left":0,"top":0,"width":1200,"element_type":"Group","group_type":"user","background_style":"none","min_width_px":0,"default_width":10,"min_height_px":0,"element_version":5,"container_layout":"column"},"type":"CustomDefinition","id":"bTKGG0","elements":{"bTKGN0":{"properties":{"height":68,"left":0,"top":0,"width":110,"zindex":2,"data_source":{"type":"ElementParent"},"group_type":"user","bgcolor":"rgba(255,255,255,1)","reference":"bTKGS0","fit_height":true,"offset_top":24,"offset_left":-134,"padding_left":0,"single_width":true,"min_width_css":"134px","single_height":false,"min_height_css":"66px","horiz_alignment":"flex-start","container_layout":"column"},"type":"GroupFocus","id":"bTKGI0","current_parent":"bTKGG0.elements","default_name":"GroupFocus A","elements":{"bTJfe":{"properties":{"height":48,"left":50,"top":7,"width":233,"zindex":2,"border_color":"rgba(131,133,140,1)","border_roundness":8,"border_width":2,"data_sour