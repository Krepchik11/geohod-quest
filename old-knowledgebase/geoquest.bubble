":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMVL"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMVK","default_name":"Group LZZZ","name":"Group Hidden_open_How_to_go_hiking"}},"name":"Group Text_and_hidden_group_how_to_go_hiking"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":5,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMVL","default_name":"Group LZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":" Всё довольно просто! Нужно пройти несколько несложных этапов:\n\nДля начала нужно определиться с маршрутом и датами. Если вы уже примерно знаете, чего хотите, то зайдите на сайт и через «Календарь походов» или поиск по регионам выберите то, что заинтересует больше всего. Второй способ для тех, кто любит решать вопросы быстро, или нуждается в помощи со стороны — позвоните по телефону на бесплатную горячую линию +7 800 200-70-23. Всё расскажем и подберём!\nКликните по кнопке «Хочу в путешествие» на сайте и заполните заявку. \nДождитесь звонка координатора! Он или она ответит на все вопросы по почте и телефону, проинформирует о способах оплаты, списке необходимого снаряжения, билетах и других важных вещах.\nВнесите предоплату, чтобы забронировать место в походе.\nСледуйте дальнейшим рекомендациям координатора. \nЗа неделю до похода на электронную почту вы получите «Памятку» с телефоном инструктора, информацией о времени и месте встречи группы, и список группы. Готово, скоро вы отправитесь в приключение!            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMWE","default_name":"Text BZZ"}},"name":"Group Hidden_how_to_go_hiking"}},"name":"Group How_to_go_hiking","order":7},"bTMYY":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":12,"border_roundness":10,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":2,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-start","container_layout":"column"},"states":{"1":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"},"min_width_css":"0px"},"type":"State"}},"type":"Group","id":"bTMWI","current_parent":"bTMJj.elements","default_name":"Group MZZZ","elements":{"bTMOF":{"properties":{"height":3,"left":0,"top":0,"width":100,"zindex":2,"background_style":"none","order":1,"fit_height":true,"single_width":true,"margin_bottom":32,"min_width_css":"100%","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"row","container_horiz_alignment":"space-between"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMWN"},"type":"GetElement","said":"Z2VvcXVlc3Q="},"properties":{"margin_bottom":0},"type":"State"}},"type":"Group","id":"bTMWK","default_name":"Group MZZZ","elements":{"bTMOJ":{"properties":{"text":{"entries":{"0":"Что делать если мне нужно вернуться раньше или приехать позже ?"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":2,"left":0,"top":0,"width":16,"zindex":3,"font_color":"rgba(35,35,35,1)","font_size":18,"line_height":1,"order":1,"fit_width":true,"fit_height":true,"font_family":"Rubik","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"94%","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMWL","default_name":"Text CZZ"},"bTMOM":{"properties":{"height":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMWN"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMWM","default_name":"Group MZZZ","name":"Group Hidden_open_What_to_do_if_I_need_to_be_back_earlier_or_arrive_later"}},"name":"Group Text_and_hidden_group_what_to_do_if_I_need_to_be_back_earlier_or_arrive_later"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMWN","default_name":"Group MZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":"Лучше всего обсудить этот вопрос с инструктором через координатора заранее, до бронирования места в походе. Большинство маршрутов завязаны на предоставляемый трансфер, а также нужно учитывать удалённость от населенных пунктов, трафик, местность, тип маршрута и т. д., так что уехать раньше или приехать позже вряд ли получится, либо придётся добираться за свой счёт.            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMWO","default_name":"Text CZZ"}},"name":"Group Hidden_what_to_do_if_I_need_to_be_back_earlier_or_arrive_later","style":"Group_default_group_"}},"name":"Group What_to_do_if_I_need_to_be_back_earlier_or_arrive_later","order":3},"bTMYZ":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":13,"border_roundness":10,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":3,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-start","container_layout":"column"},"states":{"1":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"},"min_width_css":"0px"},"type":"State"}},"type":"Group","id":"bTMWY","current_parent":"bTMJj.elements","default_name":"Group NZZZ","elements":{"bTMOF":{"properties":{"height":3,"left":0,"top":0,"width":100,"zindex":2,"background_style":"none","order":1,"fit_height":true,"single_width":true,"margin_bottom":32,"min_width_css":"100%","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"row","container_horiz_alignment":"space-between"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMWd"},"type":"GetElement","said":"Z2VvcXVlc3Q="},"properties":{"margin_bottom":0},"type":"State"}},"type":"Group","id":"bTMWa","default_name":"Group NZZZ","elements":{"bTMOJ":{"properties":{"text":{"entries":{"0":"Можно ли идти в поход если есть ограничения по состоянию здоровья,  хронические заболевания, группа инвалидности?"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":2,"left":0,"top":0,"width":16,"zindex":3,"font_color":"rgba(35,35,35,1)","font_size":18,"line_height":1,"order":1,"fit_width":true,"fit_height":true,"font_family":"Rubik","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"94%","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMWb","default_name":"Text DZZ"},"bTMOM":{"properties":{"height":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMWd"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMWc","default_name":"Group NZZZ","name":"Group Hidden_open_Is_it_possible_to_go_hiking_if_there_are_health_restrictions?"}},"name":"Group Text_and_hidden_group_Is_it_possible_to_go_hiking_if_there_are_health_restrictions?"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMWd","default_name":"Group NZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":"Всё строго индивидуально, обязательно обсудите маршрут и нагрузку с лечащим врачом и согласуйте с инструктором. Походы — это активный отдых, поэтому сложные путешествия не всегда подойдут для тех, у кого есть заболевания опорно-двигательного аппарата, также не должно быть проблем со спиной, коленями, сердцем, дыханием.\n\nДля некоторых приключений требуется опыт и хорошая физическая форма, но есть и лёгкие маршруты. Они доступны большинству людей, поэтому всегда можно подобрать для себя лучший вариант.\n\nРекомендуем трезво оценивать свои силы и согласовывать спорные моменты с координаторами. Ни в коем случае не скрывайте от координатора состояние здоровья, ведь именно это позволит сделать путешествие максимально комфортным и приятным.\n            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMWe","default_name":"Text DZZ"}},"name":"Group Hidden_Is_it_possible_to_go_hiking_if_there_are_health_restrictions?","style":"Group_default_group_"}},"name":"Group Is_it_possible_to_go_hiking_if_there_are_health_restrictions?","order":4},"bTMYa":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":14,"border_roundness":10,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":4,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-start","container_layout":"column"},"states":{"1":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"max_width_css":{"type":"Empty"},"min_width_css":"0px"},"type":"State"}},"type":"Group","id":"bTMWo","current_parent":"bTMJj.elements","default_name":"Group OZZZ","elements":{"bTMOF":{"properties":{"height":3,"left":0,"top":0,"width":100,"zindex":2,"background_style":"none","order":1,"fit_height":true,"single_width":true,"margin_bottom":32,"min_width_css":"100%","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","container_layout":"row","container_horiz_alignment":"space-between"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMWt"},"type":"GetElement","said":"Z2VvcXVlc3Q="},"properties":{"margin_bottom":0},"type":"State"}},"type":"Group","id":"bTMWq","default_name":"Group OZZZ","elements":{"bTMOJ":{"properties":{"text":{"entries":{"0":"У меня нет своего снаряжения. Можно взять в аренду рюкзак, палатку, лыжи и другие полезные вещи ?"},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":2,"left":0,"top":0,"width":16,"zindex":3,"font_color":"rgba(35,35,35,1)","font_size":18,"line_height":1,"order":1,"fit_width":true,"fit_height":true,"font_family":"Rubik","font_weight":"500","padding_top":0,"padding_left":0,"single_width":false,"max_width_css":"94%","min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMWr","default_name":"Text EZZ"},"bTMOM":{"properties":{"height":14,"left":0,"top":0,"width":14,"zindex":4,"background_style":"image","bgcolor":"rgba(79,203,155,1)","background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121616187x287807866009464960/icon_top.svg"},"type":"TextExpression"},"order":2,"fit_height":true,"single_width":true,"min_width_css":"20px","single_height":false,"min_height_css":"11px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"type":"Message","name":"isnt_visible"},"properties":{"element_id":"bTMWt"},"type":"GetElement"},"properties":{"background_image":{"entries":{"0":"//s3.amazonaws.com/appforest_uf/f1677121689871x824576265431578100/icon_down.svg"},"type":"TextExpression"}},"type":"State"}},"type":"Group","id":"bTMWs","default_name":"Group OZZZ","name":"Group Hidden_open_I_don't_have_equipment"}},"name":"Group Text_and_hidden_group_I_don't_have_equipment"},"bTMOw":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":6,"is_visible":false,"background_style":"none","order":4,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTMWt","default_name":"Group OZZZ","elements":{"bTMWH":{"properties":{"text":{"entries":{"0":"Не у каждого дома лежит набор походника на все случаи жизни и погодные условия, особенно если вы пока новичок в этих делах. Разное недостающее снаряжение можно взять в аренду под залог в наших офисах в Москве и Санкт-Петербурге за определённую плату. Координатор похода расскажет вам, какое снаряжение подойдёт для вашего типа похода, а сотрудники офиса подберут нужный размер, например, лыж. Арендованные вещи нужно будет самостоятельно забрать и привезти обратно после возвращения в город. Взять снаряжение в аренду могут только участники походов с «Клубом Приключений».            "},"type":"TextExpression"},"bold":false,"font_face":"var(--font_default):::regular","height":17,"left":0,"top":0,"width":75,"zindex":7,"font_color":"rgba(114, 114, 114, 1)","font_size":16,"line_height":1.3,"order":1,"fit_width":true,"fit_height":true,"font_family":"DM Sans","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"min_width_css":"0px","padding_right":0,"single_height":false,"min_height_css":"0px","padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"bTMWu","default_name":"Text EZZ"}},"name":"Group Hidden_I_don't_have_equipment","style":"Group_default_group_"}},"name":"Group I_don't_have_equipment","order":5}},"name":"Group Left_4_point_faq"},"bTMYm":{"properties":{"height":0,"left":0,"top":0,"width":0,"zindex":20,"background_style":"none","order":2,"fit_height":true,"padding_top":10,"padding_left":10,"single_width":false,"min_width_css":"0px","padding_right":10,"single_height":false,"min_height_css":"0px","padding_bottom":10,"horiz_alignment":"flex-start","container_layout":"column"},"states":{"0":{"condition":{"next":{"args":992,"type":"Message","name":"less_or_equal_than"},"properties":{"name":"Current Page Width"},"type":"PageData"},"properties":{"min_width_css":"100%"},"type":"State"}},"type":"Group","id":"bTMYb","default_name":"Group VZZZ","elements":{"bTMYe":{"properties":{"height":3,"left":0,"top":0,"width":295,"zindex":15,"border_roundness":10,"background_style":"bgcolor","bgcolor":"rgba(233,236,240,0.6)","order":1,"fit_height":true,"padding_top":20,"padding_left":20,"single_width":false,"margin_bottom":30,"max_width_css":"683px","min_width_css":"496px","padding_right":20,"single_height":false,"min_height_css":"0px","padding_bottom":30,"horiz_alignment":"flex-star