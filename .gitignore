# Dependencies and build output
node_modules/
.venv/

# Vercel CLI state. The release pipeline runs `vercel pull` from the REPO ROOT
# (the project's Root Directory is platform/frontend and the CLI applies it), so
# the link + pulled production env land here, not under platform/frontend/.
.vercel

# Secrets
.env
.env.*
# …but `.env.example` is a committed template (no real secrets), not a secret.
!.env.example

# Logs
*.log

# Per-machine agent permissions — local state, not project configuration.
.claude/settings.local.json

# Bubble migration tooling and its working data. Local only: the raw dumps carry
# real user PII, and the importer is run by hand against a live source, not built
# or deployed with the platform.
platform/tools/bubble-import/

# Bubble migration working dump: plaintext passwords, magiclinks, 1451 emails, media
# bytes. Local only — never commit. Delete once the prod migration is verified.
fwd/
